{
  "name": "ngx-mud-ui",
  "version": "1.0.0",
  "description": "Angular component library implementing MUD — the Moldova Unified Design system by eGov Moldova",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisBriceag/ngx-mud-ui.git"
  },
  "exports": {
    "./prebuilt/*": {
      "default": "./prebuilt/*"
    },
    "./fonts/*": {
      "default": "./fonts/*"
    },
    "./breakpoints": {
      "sass": "./breakpoints/_index.scss"
    }
  },
  "peerDependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false
}
