/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "accordion/src/**/*.spec.ts",
    "avatar/src/**/*.spec.ts",
    "badge/src/**/*.spec.ts",
    "button/src/**/*.spec.ts",
    "icons/src/**/*.spec.ts",
    "inline-message/src/**/*.spec.ts",
    "input/src/**/*.spec.ts",
    "link/src/**/*.spec.ts",
    "progress-tracker/src/**/*.spec.ts",
    "segmented-control/src/**/*.spec.ts",
    "spinner/src/**/*.spec.ts",
    "tabs/src/**/*.spec.ts",
    "tag/src/**/*.spec.ts",
    "textarea/src/**/*.spec.ts",
    "tooltip/src/**/*.spec.ts"
  ]
}
