{
  "name": "ngx-mud-ui",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Denis Briceag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisBriceag/ngx-mud-ui.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node tools/build-prebuilt.mjs && node tools/build-schematics.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:tools": "vitest run --project tools",
    "test:schematics": "vitest run --project schematics",
    "test:stories": "vitest run --project storybook",
    "icons:generate": "node tools/generate-icons.mjs projects/ngx-mud-ui/icons-source projects/ngx-mud-ui/icons/src/lib",
    "storybook": "ng run ngx-mud-ui:storybook",
    "build-storybook": "ng run ngx-mud-ui:build-storybook",
    "lint": "ng lint",
    "styles:check": "node tools/check-styles.mjs",
    "stories:fonts": "node tools/check-story-fonts.mjs",
    "docs:json": "compodoc -p .storybook/tsconfig.json -e json -d . --disableProtected --disablePrivate --disableInternal --silent",
    "postinstall": "pnpm docs:json"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-devkit/architect": "^0.2202.2",
    "@angular-devkit/core": "^22.2.2",
    "@angular-devkit/schematics": "^22.2.2",
    "@angular-eslint/builder": "22.5.0",
    "@angular/animations": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/platform-server": "22.2.2",
    "@chromatic-com/storybook": "^5.4.0",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@schematics/angular": "^22.2.2",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/angular-vite": "^10.6.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.1",
    "@types/react": "19.2.18",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.4",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "react": "19.2.8",
    "sass": "1.104.1",
    "storybook": "^10.6.1",
    "svgo": "^4.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
