{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "cache": {
      "environment": "all"
    },
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngx-mud-ui": {
      "projectType": "library",
      "root": "projects/ngx-mud-ui",
      "sourceRoot": "projects/ngx-mud-ui/src",
      "prefix": "mud",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-mud-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-mud-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-mud-ui/tsconfig.spec.json",
            "include": [
              "**/*.spec.ts",
              "../accordion/src/**/*.spec.ts",
              "../avatar/src/**/*.spec.ts",
              "../badge/src/**/*.spec.ts",
              "../banner/src/**/*.spec.ts",
              "../breadcrumb/src/**/*.spec.ts",
              "../breakpoints/src/**/*.spec.ts",
              "../button/src/**/*.spec.ts",
              "../checkbox/src/**/*.spec.ts",
              "../chip/src/**/*.spec.ts",
              "../core/src/**/*.spec.ts",
              "../date-picker/src/**/*.spec.ts",
              "../dialog/src/**/*.spec.ts",
              "../drawer/src/**/*.spec.ts",
              "../file-input/src/**/*.spec.ts",
              "../icons/src/**/*.spec.ts",
              "../info-box/src/**/*.spec.ts",
              "../inline-message/src/**/*.spec.ts",
              "../input-chip/src/**/*.spec.ts",
              "../label/src/**/*.spec.ts",
              "../link/src/**/*.spec.ts",
              "../menu/src/**/*.spec.ts",
              "../numeric-input/src/**/*.spec.ts",
              "../pagination/src/**/*.spec.ts",
              "../phone-input/src/**/*.spec.ts",
              "../radio/src/**/*.spec.ts",
              "../search-input/src/**/*.spec.ts",
              "../segmented-control/src/**/*.spec.ts",
              "../select-input/src/**/*.spec.ts",
              "../sidebar/src/**/*.spec.ts",
              "../spinner/src/**/*.spec.ts",
              "../stepper/src/**/*.spec.ts",
              "../switch/src/**/*.spec.ts",
              "../table/src/**/*.spec.ts",
              "../tabs/src/**/*.spec.ts",
              "../tag/src/**/*.spec.ts",
              "../text-input/src/**/*.spec.ts",
              "../textarea/src/**/*.spec.ts",
              "../time-picker/src/**/*.spec.ts",
              "../toast/src/**/*.spec.ts",
              "../tooltip/src/**/*.spec.ts",
              "../tree/src/**/*.spec.ts",
              "../tree-item/src/**/*.spec.ts"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "projects/ngx-mud-ui/.storybook",
            "browserTarget": "ngx-mud-ui:build",
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "projects/ngx-mud-ui/.storybook",
            "browserTarget": "ngx-mud-ui:build",
            "outputDir": "storybook-static"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-mud-ui/**/*.ts",
              "projects/ngx-mud-ui/**/*.html"
            ],
            "eslintConfig": "projects/ngx-mud-ui/eslint.config.mjs",
            "cache": true,
            "cacheLocation": ".angular/eslint-cache",
            "cacheStrategy": "content"
          }
        }
      }
    }
  }
}
