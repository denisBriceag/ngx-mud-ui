{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngx-mud-ui": {
      "projectType": "library",
      "root": "projects/ngx-mud-ui",
      "sourceRoot": "projects/ngx-mud-ui/src",
      "prefix": "mud",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-mud-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-mud-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-mud-ui/tsconfig.spec.json",
            "include": [
              "**/*.spec.ts",
              "../accordion/src/**/*.spec.ts",
              "../avatar/src/**/*.spec.ts",
              "../badge/src/**/*.spec.ts",
              "../button/src/**/*.spec.ts",
              "../icons/src/**/*.spec.ts",
              "../inline-message/src/**/*.spec.ts",
              "../input/src/**/*.spec.ts",
              "../link/src/**/*.spec.ts",
              "../progress-tracker/src/**/*.spec.ts",
              "../search-input/src/**/*.spec.ts",
              "../segmented-control/src/**/*.spec.ts",
              "../spinner/src/**/*.spec.ts",
              "../tabs/src/**/*.spec.ts",
              "../tag/src/**/*.spec.ts",
              "../textarea/src/**/*.spec.ts",
              "../tooltip/src/**/*.spec.ts"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "projects/ngx-mud-ui/.storybook",
            "browserTarget": "ngx-mud-ui:build",
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "projects/ngx-mud-ui/.storybook",
            "browserTarget": "ngx-mud-ui:build",
            "outputDir": "storybook-static"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-mud-ui/**/*.ts",
              "projects/ngx-mud-ui/**/*.html"
            ],
            "eslintConfig": "projects/ngx-mud-ui/eslint.config.mjs"
          }
        }
      }
    }
  }
}
